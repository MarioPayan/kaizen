{
  "name": "kaizen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture skill problems and collect them for a focused repair session.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "kaizen": "scripts/cli.mjs"
  },
  "scripts": {
    "kaizen": "node scripts/cli.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint scripts packages/core/src packages/core/tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}

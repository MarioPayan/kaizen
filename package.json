{
  "name": "kaizen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perpetual improvement loop for Claude Code skills.",
  "license": "MIT",
  "bin": {
    "kaizen": "scripts/cli.mjs"
  },
  "scripts": {
    "kaizen": "node scripts/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint scripts",
    "lint:fix": "eslint scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:check": "npm --prefix app run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}

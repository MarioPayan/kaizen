{
  "name": "kaizen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perpetual improvement loop for Claude Code skills.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "kaizen": "scripts/cli.mjs"
  },
  "scripts": {
    "kaizen": "node scripts/cli.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run type-check && npm run lint && npm run test",
    "build": "npm run build --workspace @kaizen/app",
    "dev": "npm run dev --workspace @kaizen/app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
